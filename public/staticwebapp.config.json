{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/*.{svg,png,jpg,ico,css,js,webmanifest}"]
  },
  "routes": [
    {
      "route": "/sw.js",
      "headers": { "Cache-Control": "no-cache" }
    }
  ],
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  }
}