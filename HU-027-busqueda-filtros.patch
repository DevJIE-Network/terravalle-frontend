+    expect(field('Precio mínimo (MXN)')).toHaveAttribute('aria-invalid', 'true');
+    expect(field('Tipo de inmueble')).toHaveAttribute('aria-invalid', 'true');
+    expect(screen.queryByRole('article')).not.toBeInTheDocument();
